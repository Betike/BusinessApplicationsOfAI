# Copy this file to .env (git-ignored) and fill in your own values.
# Never commit the real .env file or paste keys into the notebook.

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used by the recommender (check the free-tier models/quota shown in AI Studio)
LLM_MODEL=gemini-2.5-flash
# Optional: separate model for the LLM-as-judge evaluation (defaults to LLM_MODEL)
JUDGE_MODEL=
# Optional: OpenAI-compatible endpoint (default: Gemini). Lets Project 2 swap providers.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
